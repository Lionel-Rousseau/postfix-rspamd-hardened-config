# =============================================================================
# /etc/letsencrypt/renewal/<hostname>.conf — certbot renewal configuration
#
# Both MX hosts use identical parameters. Key choices:
#
#   key_type = ecdsa          ECDSA is smaller and faster than RSA for TLS
#                             handshakes. Consistent with the ECDH curve
#                             preferences configured in Postfix (X25519,
#                             prime256v1) and Dovecot (X25519, prime256v1).
#
#   elliptic_curve = secp256r1  P-256 — widely supported, NIST-approved,
#                              same curve used as tls_eecdh_strong_curve in
#                              Postfix and first in Dovecot's ssl_curve_list.
#
#   reuse_key = True          The private key is reused on each renewal.
#                             Combined with TLSA selector 1 (SubjectPublicKeyInfo),
#                             this means DANE TLSA records are stable for the
#                             lifetime of the key — zero maintenance.
#                             See docs/dns-records.md — Strategy A.
#
#   authenticator = nginx     HTTP-01 challenge served by the nginx instance
#                             co-located with Postfix for webmail / MTA-STS.
# =============================================================================

# renew_before_expiry = 30 days
version = 2.9.0
archive_dir = /etc/letsencrypt/archive/web-mail.example.org
cert      = /etc/letsencrypt/live/web-mail.example.org/cert.pem
privkey   = /etc/letsencrypt/live/web-mail.example.org/privkey.pem
chain     = /etc/letsencrypt/live/web-mail.example.org/chain.pem
fullchain = /etc/letsencrypt/live/web-mail.example.org/fullchain.pem

[renewalparams]
account          = <LETSENCRYPT-ACCOUNT-ID>
authenticator    = nginx
installer        = nginx
server           = https://acme-v02.api.letsencrypt.org/directory
key_type         = ecdsa
reuse_key        = True
elliptic_curve   = secp256r1
