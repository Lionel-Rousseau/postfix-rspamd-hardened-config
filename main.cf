# =============================================================================
# /etc/postfix/main.cf — primary MX (web-mail.example.org)
# Postfix 3.x on Ubuntu 24.04 LTS
# =============================================================================

# ---------------------------------------------------------------------------
# Compatibility
# ---------------------------------------------------------------------------
compatibility_level = 3.6

# ---------------------------------------------------------------------------
# Installation paths (Debian/Ubuntu defaults)
# ---------------------------------------------------------------------------
queue_directory   = /var/spool/postfix
command_directory = /usr/sbin
daemon_directory  = /usr/lib/postfix/sbin
data_directory    = /var/lib/postfix
mail_owner        = postfix

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
myhostname = web-mail.example.org
mydomain   = example.org
myorigin   = $myhostname

# ---------------------------------------------------------------------------
# Network interfaces and protocols
# ---------------------------------------------------------------------------
inet_interfaces = all
inet_protocols  = all

# ---------------------------------------------------------------------------
# Local delivery destinations
# ---------------------------------------------------------------------------
mydestination = $myhostname, localhost.$mydomain, localhost

# Reject mail for unknown local users with a permanent error
unknown_local_recipient_reject_code = 550

# ---------------------------------------------------------------------------
# Trusted networks — mynetworks relay unconditionally
# ---------------------------------------------------------------------------
mynetworks = 203.0.113.10/32, 127.0.0.0/8, [::1]/128, [fe80::]/64, [2001:db8:0:1::]/128

# ---------------------------------------------------------------------------
# Alias maps
# ---------------------------------------------------------------------------
alias_maps     = hash:/etc/aliases
alias_database = hash:/etc/aliases

# ---------------------------------------------------------------------------
# Address extensions (user+tag)
# ---------------------------------------------------------------------------
recipient_delimiter = +

# ---------------------------------------------------------------------------
# SMTP banner — no version disclosure
# ---------------------------------------------------------------------------
smtpd_banner = $myhostname ESMTP $mydomain

# ---------------------------------------------------------------------------
# Debug
# ---------------------------------------------------------------------------
debug_peer_level  = 3
debugger_command  =
    PATH=/bin:/usr/bin:/usr/local/bin:/usr/X11R6/bin
    ddd $daemon_directory/$process_name $process_id & sleep 5

# ---------------------------------------------------------------------------
# Sendmail-compatible commands (Debian package paths)
# ---------------------------------------------------------------------------
sendmail_path    = /usr/sbin/sendmail
newaliases_path  = /usr/bin/newaliases
mailq_path       = /usr/bin/mailq
setgid_group     = postdrop
html_directory   = no
manpage_directory = /usr/share/man

# =============================================================================
# =============================================================================

# ---------------------------------------------------------------------------
# Dovecot LMTP delivery
# ---------------------------------------------------------------------------
virtual_transport                  = lmtp:unix:private/dovecot-lmtp
dovecot_destination_recipient_limit = 1

# ---------------------------------------------------------------------------
# General settings
# ---------------------------------------------------------------------------
default_process_limit  = 300
append_dot_mydomain    = no
biff                   = no
config_directory       = /etc/postfix
delay_warning_time     = 4h
mailbox_size_limit     = 0
masquerade_domains     = example.org
message_size_limit     = 100000000
smtpd_recipient_limit  = 150
virtual_alias_maps     = hash:/etc/postfix/user_aliases,regexp:/etc/postfix/aliases-regexp
virtual_gid_maps       = static:6000
virtual_mailbox_base   = /home/vmail
virtual_mailbox_domains = /etc/postfix/domains
virtual_mailbox_limit  = 0
virtual_mailbox_maps   = hash:/etc/postfix/user_mailboxes_path
virtual_minimum_uid    = 6000
virtual_uid_maps       = static:6000

# ---------------------------------------------------------------------------
# Header checks (PCRE)
# ---------------------------------------------------------------------------
header_checks = pcre:/etc/postfix/header_checks

# ---------------------------------------------------------------------------
# Milter chain
# Ports: 11332=Rspamd  8891=OpenDKIM  8893=OpenDMARC  8894=OpenARC
# ClamAV milter (7357 / unix socket) kept here for reference — currently
# handled by Rspamd antivirus module (local.d/antivirus.conf).
# ---------------------------------------------------------------------------
milter_default_action = accept
milter_protocol       = 6
smtpd_milters         = inet:localhost:11332, inet:127.0.0.1:8891, inet:127.0.0.1:8893, inet:127.0.0.1:8894
non_smtpd_milters     = inet:localhost:11332, inet:127.0.0.1:8891, inet:127.0.0.1:8893, inet:127.0.0.1:8894
milter_mail_macros    = i {mail_addr} {client_addr} {client_name} {auth_authen}

# ---------------------------------------------------------------------------
# SASL authentication (Dovecot backend)
# ---------------------------------------------------------------------------
smtpd_sasl_type                   = dovecot
smtpd_sasl_path                   = private/auth
smtpd_sasl_auth_enable            = yes
broken_sasl_auth_clients          = yes
smtpd_sasl_security_options       = noanonymous
smtpd_sasl_tls_security_options   = noanonymous

# ---------------------------------------------------------------------------
# TLS server (inbound)
# ---------------------------------------------------------------------------
smtpd_tls_key_file              = /etc/letsencrypt/live/web-mail.example.org/privkey.pem
smtpd_tls_cert_file             = /etc/letsencrypt/live/web-mail.example.org/fullchain.pem
smtpd_tls_dh1024_param_file     = /etc/postfix/ffdhe4096.pem
smtpd_tls_dh512_param_file      = /etc/postfix/dh512.pem
tls_eecdh_auto_curves           = X25519, prime256v1, secp384r1, X448, secp521r1
tls_eecdh_strong_curve          = prime256v1
tls_eecdh_ultra_curve           = secp384r1
smtpd_tls_eecdh_grade           = auto
smtpd_tls_security_level        = may
smtpd_tls_received_header       = yes
smtpd_tls_session_cache_timeout = 3600s
tls_random_source               = dev:/dev/urandom
smtpd_tls_loglevel              = 1
smtpd_tls_auth_only             = yes
smtpd_enforce_tls               = yes
smtpd_use_tls                   = yes
tls_config_file                 = /etc/postfix/tls_config.conf
tls_config_name                 = postfix

# ---------------------------------------------------------------------------
# TLS client (outbound) — DANE enabled, requires DNSSEC
# ---------------------------------------------------------------------------
smtp_use_tls                  = yes
smtp_tls_note_starttls_offer  = yes
smtp_tls_loglevel             = 1
smtp_dns_support_level        = dnssec
smtp_host_lookup              = dns
smtp_tls_security_level       = dane

# ---------------------------------------------------------------------------
# Restriction evaluation — wait until RCPT TO before applying
# ---------------------------------------------------------------------------
smtpd_delay_reject = yes

# ---------------------------------------------------------------------------
# Basic SMTP strictness
# ---------------------------------------------------------------------------
smtpd_helo_required    = yes
strict_rfc821_envelopes = yes

# ---------------------------------------------------------------------------
# Client restrictions
# ---------------------------------------------------------------------------
smtpd_client_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    check_client_access hash:/etc/postfix/rbl_override,
    permit

# ---------------------------------------------------------------------------
# HELO restrictions
# ---------------------------------------------------------------------------
smtpd_helo_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_invalid_helo_hostname,
    reject_non_fqdn_helo_hostname,
    check_helo_access hash:/etc/postfix/rbl_override,
    permit

smtpd_data_restrictions =
    reject_unauth_pipelining

# ---------------------------------------------------------------------------
# Sender restrictions
# ---------------------------------------------------------------------------
smtpd_sender_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    check_sender_access hash:/etc/postfix/sender_allow_internal,
    reject_sender_login_mismatch,
    reject_unknown_sender_domain,
    reject_invalid_hostname,
    reject_unknown_reverse_client_hostname,
    reject_unknown_client_hostname,
    reject_non_fqdn_sender,
    reject_unlisted_sender,
    check_sender_access hash:/etc/postfix/rbl_override,
    permit

# ---------------------------------------------------------------------------
# Recipient restrictions — the main anti-spam policy chain
# Abusix Mail Intelligence (primary RBL provider since 2023 — Spamhaus DQS
# was evaluated but retired due to false-positive on a known partner domain
# and disproportionate cost for this traffic volume).
# ---------------------------------------------------------------------------
smtpd_recipient_restrictions =
    permit_mynetworks,
    permit_sasl_authenticated,
    reject_invalid_hostname,
    reject_non_fqdn_sender,
    reject_non_fqdn_recipient,
    reject_unknown_sender_domain,
    reject_unknown_recipient_domain,
    reject_unauth_pipelining,
    reject_unauth_destination,
    check_client_access hash:/etc/postfix/rbl_override,
    check_sender_access hash:/etc/postfix/sender_checks,
    reject_rhsbl_helo   xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.dblack.mail.abusix.zone,
    reject_rhsbl_sender xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.dblack.mail.abusix.zone,
    check_policy_service unix:private/policyd-spf,
    check_sender_mx_access cidr:/etc/postfix/reject_private_mx.cidr,
    permit

rbl_reply_maps = texthash:/etc/postfix/rbl_reply_map
transport_maps = hash:/etc/postfix/transport

# ---------------------------------------------------------------------------
# Postscreen — first line of defence on port 25
# Abusix feeds weighted at *2; Barracuda and SpamCop at *1.
# DNSWL trusted senders get -1 (whitelist offset).
# ---------------------------------------------------------------------------
postscreen_access_list        = permit_mynetworks, cidr:/etc/postfix/postscreen_access.cidr
postscreen_blacklist_action   = drop
postscreen_greet_wait         = 3s
postscreen_greet_banner       = Waiting for a moment...
postscreen_greet_action       = drop

postscreen_dnsbl_sites =
    bl.spamcop.net*1,
    b.barracudacentral.org*1,
    xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.black.mail.abusix.zone*2,
    xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.exploit.mail.abusix.zone*2,
    xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.dynamic.mail.abusix.zone*1,
    list.dnswl.org=127.0.[0..255].[1..3]*-1

postscreen_dnsbl_reply_map    = texthash:/etc/postfix/postscreen_dnsbl_reply_map
postscreen_dnsbl_threshold    = 3
postscreen_dnsbl_action       = drop

# ---------------------------------------------------------------------------
# TLS cipher configuration
# See also: /etc/postfix/tls_config.conf
# ---------------------------------------------------------------------------
tls_ssl_options        = NO_COMPRESSION, NO_RENEGOTIATION
tls_preempt_cipherlist = yes

tls_high_cipherlist   = EDH+aRSA:EECDH+aRSA+AESGCM:EECDH+aRSA+SHA384:EECDH+aRSA+SHA256:EECDH:+AES256:+AES128:+SSLv3:!aNULL:!eNULL:!LOW:!3DES:!MD5:!EXP:!PSK:!DSS:!RC4:!SEED:!CAMELLIA
tls_medium_cipherlist = ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384:!aNULL:!eNULL:!SSLv2:!MD5:!DES:!EXP:!SEED:!IDEA:!3DES:!CAMELLIA

smtpd_tls_ciphers          = medium
smtp_tls_ciphers           = high
smtp_tls_mandatory_ciphers = high
smtpd_tls_mandatory_ciphers = medium

smtp_tls_exclude_ciphers  = EXP, LOW, DES, 3DES, SSLv2, MD5, DES+MD5, RC4, aNULL, eNULL, EXPORT, PSK, aECDH, EDH-DSS-DES-CBC3-SHA, EDH-RSA-DES-CDC3-SHA, KRB5-DE5, CBC3-SHA, DHE-RSA-CAMELLIA256-SHA, DHE-RSA-CAMELLIA128-SHA
smtpd_tls_exclude_ciphers = EXP, LOW, DES, 3DES, SSLv2, MD5, DES+MD5, RC4, aNULL, eNULL, EXPORT, PSK, aECDH, EDH-DSS-DES-CBC3-SHA, EDH-RSA-DES-CDC3-SHA, KRB5-DE5, CBC3-SHA, DHE-RSA-CAMELLIA256-SHA, DHE-RSA-CAMELLIA128-SHA

# TLS 1.2 minimum — TLS 1.0 and 1.1 explicitly excluded
smtpd_tls_mandatory_protocols = !TLSv1.1, !TLSv1, !SSLv2, !SSLv3
smtpd_tls_protocols           = !TLSv1.1, !TLSv1, !SSLv2, !SSLv3
smtp_tls_mandatory_protocols  = !TLSv1.1, !TLSv1, !SSLv2, !SSLv3
smtp_tls_protocols            = !TLSv1.1, !TLSv1, !SSLv2, !SSLv3

# ---------------------------------------------------------------------------
# SMTP client timeouts (increased for large international transfers)
# Default values shown in comments for reference.
# ---------------------------------------------------------------------------
smtp_data_xfer_timeout = 1800s   # default: 180s
smtp_data_done_timeout = 6000s   # default: 600s
smtp_data_init_timeout = 1200s   # default: 120s
smtp_mail_timeout      = 3000s   # default: 300s

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
disable_vrfy_command = yes
# =============================================================================
